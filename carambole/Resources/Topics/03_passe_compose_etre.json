{
  "id": "passe_compose_etre",
  "title": "Passé composé — verbes avec être",
  "sortOrder": 3,
  "prerequisiteID": "er_verbs_present",
  "ruleNote": "A small set of motion/state verbs form the passé composé with être (not avoir). Their past participle agrees with the subject in gender and number.",
  "exercises": [
    {"id":"pce_01","topicID":"passe_compose_etre","type":"conjugate","prompt":"Il ___ (partir) hier soir.","cue":"partir","answerTokens":["est","parti"],"tokenBank":["a","est","parti","partie","partis"],"inputMode":"buildFromTokens","explanation":"être verb → the participle agrees with the subject. Il = masculine singular → parti.","translation":"He left last night.","hint":"'partir' uses être; the participle agrees with the subject."},
    {"id":"pce_02","topicID":"passe_compose_etre","type":"conjugate","prompt":"Elle ___ (arriver) en retard.","cue":"arriver","answerTokens":["est","arrivée"],"tokenBank":["a","est","arrivé","arrivée","arrivés"],"inputMode":"buildFromTokens","explanation":"Feminine singular subject → add -e: arrivée.","translation":"She arrived late.","hint":"Feminine singular subject → add -e to the participle."},
    {"id":"pce_03","topicID":"passe_compose_etre","type":"conjugate","prompt":"Ils ___ (aller) au cinéma.","cue":"aller","answerTokens":["sont allés"],"tokenBank":["sont allés","ont allés","sont allé","est allés"],"inputMode":"multipleChoice","explanation":"être verb, masculine plural → add -s: sont allés.","translation":"They went to the cinema.","hint":"être verb, masculine plural → participle ends in -s."},
    {"id":"pce_04","topicID":"passe_compose_etre","type":"conjugate","prompt":"Elles ___ (rester) à la maison.","cue":"rester","answerTokens":["sont restées"],"tokenBank":["sont restées","ont resté","sont resté","sont restés"],"inputMode":"multipleChoice","explanation":"Feminine plural → add -es: sont restées.","translation":"They (f.) stayed at home.","hint":"Feminine plural → participle ends in -es."},
    {"id":"pce_05","topicID":"passe_compose_etre","type":"conjugate","prompt":"Nous ___ (venir) ensemble.","cue":"venir","answerTokens":["sommes","venus"],"tokenBank":["avons","sommes","venu","venus","venues"],"inputMode":"buildFromTokens","explanation":"être verb; nous (masc./mixed) → venus.","translation":"We came together.","hint":"être verb; with 'nous' the participle here ends in -us."},
    {"id":"pce_06","topicID":"passe_compose_etre","type":"conjugate","prompt":"Marie et Anne ___ (tomber).","cue":"tomber","answerTokens":["sont","tombées"],"tokenBank":["ont","sont","tombé","tombées","tombés"],"inputMode":"buildFromTokens","explanation":"Two feminine subjects → feminine plural: sont tombées.","translation":"Marie and Anne fell.","hint":"Two feminine subjects → feminine plural agreement (-es)."}
  ]
}

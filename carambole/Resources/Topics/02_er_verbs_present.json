{
  "id": "er_verbs_present",
  "title": "Verbes en -ER au présent",
  "sortOrder": 2,
  "prerequisiteID": "etre_avoir_present",
  "ruleNote": "Regular -ER verbs (parler, aimer, habiter…) share one present-tense pattern: drop -er, then add -e, -es, -e, -ons, -ez, -ent.",
  "exercises": [
    {"id":"erv_01","topicID":"er_verbs_present","type":"conjugate","prompt":"Je ___ français. (parler)","cue":"parler","answerTokens":["parle"],"tokenBank":["parle","parles","parlons","parlez"],"inputMode":"multipleChoice","explanation":"je → -e ending: parle.","translation":"I speak French.","hint":"je → -e."},
    {"id":"erv_02","topicID":"er_verbs_present","type":"conjugate","prompt":"Vous ___ à Paris. (habiter)","cue":"habiter","answerTokens":["habitez"],"tokenBank":["habitez","habites","habitons","habite"],"inputMode":"multipleChoice","explanation":"vous → -ez ending: habitez.","translation":"You live in Paris.","hint":"vous → -ez."},
    {"id":"erv_03","topicID":"er_verbs_present","type":"conjugate","prompt":"Ils ___ le café. (aimer)","cue":"aimer","answerTokens":["aiment"],"tokenBank":["aiment","aime","aimes","aimez"],"inputMode":"multipleChoice","explanation":"ils/elles → -ent ending (silent): aiment.","translation":"They like coffee.","hint":"ils/elles → -ent."},
    {"id":"erv_04","topicID":"er_verbs_present","type":"wordOrder","prompt":"Construis : « We speak French. »","cue":null,"answerTokens":["Nous","parlons","français"],"tokenBank":["Nous","parlons","parlez","français"],"inputMode":"buildFromTokens","explanation":"nous → -ons ending: parlons.","translation":"We speak French.","hint":"nous → -ons."},
    {"id":"erv_05","topicID":"er_verbs_present","type":"conjugate","prompt":"Tu ___ la musique. (écouter)","cue":"écouter","answerTokens":["écoutes"],"tokenBank":["écoutes","écoute","écoutez","écoutent"],"inputMode":"multipleChoice","explanation":"tu → -es ending: écoutes. (écouter takes no preposition.)","translation":"You listen to music.","hint":"tu → -es."}
  ]
}

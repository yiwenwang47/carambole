  "ruleNote": "être (to be) and avoir (to have) are the two essential irregular verbs — you use them everywhere, including to build past tenses.",
  "exercises": [
    {"id":"eap_01","topicID":"etre_avoir_present","type":"conjugate","prompt":"Tu ___ français. (être)","cue":"être","answerTokens":["es"],"tokenBank":["es","est","suis","as"],"inputMode":"multipleChoice","explanation":"With 'tu', être becomes 'es'.","translation":"You are French.","hint":"tu form of être → es."},
    {"id":"eap_02","topicID":"etre_avoir_present","type":"conjugate","prompt":"Elle ___ un chat. (avoir)","cue":"avoir","answerTokens":["a"],"tokenBank":["a","as","est","ont"],"inputMode":"multipleChoice","explanation":"With 'il/elle', avoir becomes 'a' (no accent).","translation":"She has a cat.","hint":"il/elle form of avoir → a."},
    {"id":"eap_03","topicID":"etre_avoir_present","type":"conjugate","prompt":"Nous ___ contents. (être)","cue":"être","answerTokens":["sommes"],"tokenBank":["sommes","êtes","sont","avons"],"inputMode":"multipleChoice","explanation":"With 'nous', être becomes 'sommes'.","translation":"We are happy.","hint":"nous form of être → sommes."},
    {"id":"eap_04","topicID":"etre_avoir_present","type":"wordOrder","prompt":"Construis : « They have a dog. »","cue":null,"answerTokens":["Ils","ont","un","chien"],"tokenBank":["Ils","ont","un","chien","est"],"inputMode":"buildFromTokens","explanation":"Subject 'Ils' + avoir 'ont' + 'un chien'.","translation":"They have a dog.","hint":"ils form of avoir → ont."},
    {"id":"eap_05","topicID":"etre_avoir_present","type":"conjugate","prompt":"Ils ___ faim. (avoir)","cue":"avoir","answerTokens":["ont"],"tokenBank":["ont","sont","avez","a"],"inputMode":"multipleChoice","explanation":"French uses avoir for hunger ('avoir faim'); ils → ont.","translation":"They are hungry.","hint":"avoir faim = to be hungry; ils → ont."}

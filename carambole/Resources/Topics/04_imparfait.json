{
  "id": "imparfait",
  "title": "L'imparfait",
  "sortOrder": 4,
  "prerequisiteID": "passe_compose_etre",
  "ruleNote": "The imparfait describes ongoing or habitual past actions ('was doing', 'used to do'). Take the present 'nous' form, drop -ons, and add -ais, -ais, -ait, -ions, -iez, -aient.",
  "exercises": [
    {"id":"imp_01","topicID":"imparfait","type":"conjugate","prompt":"Quand j'étais petit, je ___ au parc. (jouer)","cue":"jouer","answerTokens":["jouais"],"tokenBank":["jouais","jouait","joue","jouer"],"inputMode":"multipleChoice","explanation":"je imparfait → -ais: jouais.","translation":"When I was little, I used to play at the park.","hint":"je → -ais."},
    {"id":"imp_02","topicID":"imparfait","type":"conjugate","prompt":"Elle ___ toujours en retard. (être)","cue":"être","answerTokens":["était"],"tokenBank":["était","est","étais","sont"],"inputMode":"multipleChoice","explanation":"être has the irregular imparfait stem 'ét-'; il/elle → était.","translation":"She was always late.","hint":"être stem ét- → était."},
    {"id":"imp_03","topicID":"imparfait","type":"conjugate","prompt":"Nous ___ à la campagne. (habiter)","cue":"habiter","answerTokens":["habitions"],"tokenBank":["habitions","habitons","habitiez","habitait"],"inputMode":"multipleChoice","explanation":"nous imparfait → -ions: habitions.","translation":"We used to live in the countryside.","hint":"nous → -ions."},
    {"id":"imp_04","topicID":"imparfait","type":"wordOrder","prompt":"Construis : « They were eating. »","cue":null,"answerTokens":["Ils","mangeaient"],"tokenBank":["Ils","mangeaient","mangent","mangeait"],"inputMode":"buildFromTokens","explanation":"manger keeps the e (mange-) before -aient: mangeaient.","translation":"They were eating.","hint":"ils → -aient (manger keeps the e)."},
    {"id":"imp_05","topicID":"imparfait","type":"conjugate","prompt":"Tu ___ la télé. (regarder)","cue":"regarder","answerTokens":["regardais"],"tokenBank":["regardais","regardait","regardes","regarder"],"inputMode":"multipleChoice","explanation":"tu imparfait → -ais: regardais.","translation":"You were watching TV.","hint":"tu → -ais."}
  ]
}
